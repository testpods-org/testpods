<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="TESTPODS_LOG_LEVEL" value="${testpods.log.level:-INFO}"/>
    <property name="FABRIC8_LOG_LEVEL" value="${fabric8.log.level:-INFO}"/>
    <property name="SPRING_LOG_LEVEL" value="${spring.log.level:-INFO}"/>
    <property name="KAFKA_LOG_LEVEL" value="${kafka.log.level:-INFO}"/>
    <property name="TESTCONTAINERS_LOG_LEVEL" value="${testcontainers.log.level:-INFO}"/>
    <property name="HTTP_LOG_LEVEL" value="${http.log.level:-INFO}"/>
    <property name="ROOT_LOG_LEVEL" value="${root.log.level:-INFO}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{48} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.testpods" level="${TESTPODS_LOG_LEVEL}"/>
    <logger name="io.fabric8" level="${FABRIC8_LOG_LEVEL}"/>
    <logger name="org.springframework" level="${SPRING_LOG_LEVEL}"/>
    <logger name="org.apache.kafka" level="${KAFKA_LOG_LEVEL}"/>
    <logger name="org.apache.kafka.clients.admin" level="WARN"/>
    <logger name="org.apache.kafka.common" level="WARN"/>
    <logger name="org.testcontainers" level="${TESTCONTAINERS_LOG_LEVEL}"/>
    <logger name="org.apache.http" level="${HTTP_LOG_LEVEL}"/>
    <logger name="okhttp3" level="${HTTP_LOG_LEVEL}"/>
    <root level="${ROOT_LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
